# ==============================================================================
# Last.fm Data Collector & Kafka Producer Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Last.fm Audioscrobbler API Settings (REQUIRED FOR REAL DATA)
# ------------------------------------------------------------------------------
# Required 32-character API key from https://www.last.fm/api/account/create
# The collector works exclusively with real data and will not invent mock tracks.
LASTFM_API_KEY=""

# Comma-separated list of Last.fm usernames to continuously monitor.
# Defaults to 'cdessana' if omitted.
LASTFM_USERS="cdessana"

# Polling frequency per user cycle in milliseconds (default: 10000ms / 10s, min: 2000ms)
LASTFM_POLL_INTERVAL_MS=10000

# Number of recent scrobbles to retrieve per user per poll (default: 5, max: 50)
LASTFM_LIMIT=5

# ------------------------------------------------------------------------------
# 2. Apache Kafka Producer Settings (DRY-RUN vs EXTERNAL CLUSTER)
# ------------------------------------------------------------------------------
# DRY-RUN MODE:
# Set KAFKA_PRODUCER_ENABLED=false (default).
# In dry-run mode, the collector polls real Last.fm data, deduplicates events,
# logs the exact payloads to console/audit log, and streams them live via SSE to
# the web inspector. No network connection to a Kafka broker is attempted.
#
# SWITCHING TO AN EXTERNAL KAFKA CLUSTER:
# To publish collected events to your external Kafka cluster:
# 1. Set KAFKA_PRODUCER_ENABLED=true
# 2. Configure KAFKA_BOOTSTRAP_SERVERS with your broker address (e.g. localhost:9092)
# 3. Ensure the destination topic exists (or auto-create is enabled on the broker)
# 4. Restart the collector service
KAFKA_PRODUCER_ENABLED=false

# Comma-separated list of external Kafka broker addresses (host:port).
# Example: localhost:9092 or broker1.kafka.internal:9092,broker2.kafka.internal:9092
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# Destination Kafka topic name for scrobble and now-playing events
KAFKA_TOPIC="lastfm.scrobbles"

# Unique client identifier sent in Kafka broker requests
KAFKA_CLIENT_ID="lastfm-collector-producer"

# Producer acknowledgment level: -1 or 'all' (strongest durability), 1 (leader only), 0 (no ack)
KAFKA_ACKS="-1"

# Producer payload compression codec: 'none' | 'gzip' | 'snappy' | 'lz4' | 'zstd'
KAFKA_COMPRESSION="gzip"

# ------------------------------------------------------------------------------
# 3. Kafka Security & Authentication (Optional for secured clusters)
# ------------------------------------------------------------------------------
# Security protocol: 'PLAINTEXT' | 'SSL' | 'SASL_PLAINTEXT' | 'SASL_SSL'
KAFKA_SECURITY_PROTOCOL="PLAINTEXT"

# SASL authentication mechanism: 'plain' | 'scram-sha-256' | 'scram-sha-512'
KAFKA_SASL_MECHANISM=""

# SASL username (if SASL is enabled)
KAFKA_SASL_USERNAME=""

# SASL password (if SASL is enabled)
KAFKA_SASL_PASSWORD=""

# ------------------------------------------------------------------------------
# 4. Observability & Runtime Settings
# ------------------------------------------------------------------------------
# Logging verbosity: 'DEBUG' | 'INFO' | 'WARN' | 'ERROR'
LOG_LEVEL="INFO"
